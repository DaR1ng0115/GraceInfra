{
    "version": 3,
    "configurePresets": [
        {
            "name": "test",
            "binaryDir": "${sourceDir}/build/test",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_TEST": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "testWithASan",
            "binaryDir": "${sourceDir}/build/testWithASan",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_TEST": "ON",
                "ENABLE_ASAN": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },

        {
            "name": "main",
            "binaryDir": "${sourceDir}/build/main",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_MAIN": "ON"
            }
        },

        {
            "name": "python",
            "binaryDir": "${sourceDir}/build/python",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_PYTHON_API": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "clangd",
            "binaryDir": "${sourceDir}/build/clangd",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_MAIN": "ON",
                "ENABLE_TEST": "OFF",
                "ENABLE_PYTHON_API": "ON",
                "ENABLE_ASAN": "OFF",
                "ENABLE_PERF": "OFF"
            }
        }
    ]
}

